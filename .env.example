# Copy this file to .env.local and fill in what you need.
# .env.local is gitignored; .env.example (this file) is committed.
#
# There is deliberately NO Gemini API key here. Anything injected at build time
# is readable inside the shipped extension, so the AI feature asks each user for
# their own key in Settings -> AI Assistant instead.

# --- Google OAuth --------------------------------------------------------
# The client id used for sign-in lives in public/manifest.json ("oauth2").
# The value below is only for the launchWebAuthFlow fallback, which is needed
# when running as an unpacked extension (where the extension id is random and
# chrome.identity.getAuthToken cannot match a registered client).
#
# This is a public client identifier, not a secret.
VITE_GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Set to 'true' to enable that fallback. Leave false for packed/store builds.
VITE_ENABLE_WEB_AUTH_FALLBACK=false

# --- Admin panel (development only) --------------------------------------
# The admin screen is excluded from production builds entirely. In dev it stays
# locked unless you set a SHA-256 hash here. Generate one with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
VITE_ADMIN_PASSWORD_HASH=
