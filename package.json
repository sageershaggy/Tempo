{
  "name": "tempo-focus",
  "private": true,
  "version": "1.1.0",
  "description": "Tempo Focus — a Chrome extension focus timer with soundscapes, tasks, and stats.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && node scripts/package-extension.mjs",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-react": "^5.1.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
